# Shared project defaults for local development.
# Copy to .env at the project root when you want local overrides.

# --- Local API ---
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_portal
JWT_SECRET=replace-with-a-strong-local-secret
JWT_EXPIRES_IN=7d
DEMO_MODE_ENABLED=false
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# --- Local document storage ---
MEDICAL_STORAGE_PROVIDER=local
MEDICAL_UPLOADS_DIR=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=medical-documents

# --- Email delivery ---
# Server-side only. Production requires a complete configuration for the selected provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Replace these placeholders only when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-carepath-gmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=Carepath <your-carepath-gmail@gmail.com>

# --- Vercel frontend ---
VITE_API_URL=http://localhost:5000

# --- Render / production settings ---
# Set these on Render instead of committing real values.
# DATABASE_URL=postgresql://postgres:...@db.example.com:5432/healthcare_portal
# JWT_SECRET=generate-a-strong-random-value
# CLIENT_URL=https://your-app.vercel.app
# AI_SERVICE_URL=https://your-ai-service.onrender.com
# AI_SERVICE_TOKEN=generate-a-shared-service-token
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-carepath-gmail@gmail.com
# SMTP_PASS=your-google-app-password
# EMAIL_FROM=Carepath <your-carepath-gmail@gmail.com>
# RESEND_API_KEY=re_...
# DEMO_MODE_ENABLED=false

# --- AI service ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
