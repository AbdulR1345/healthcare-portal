# Local development defaults for the API.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_portal
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
DEMO_MODE_ENABLED=false
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
MEDICAL_UPLOADS_DIR=
# Development uses local private storage. Production requires a private S3 bucket
# with all public access blocked; use HTTPS for custom production endpoints.
MEDICAL_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=medical-documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email settings are server-side only and optional for application startup and
# sign-in. Configure a provider to send verification, password-reset, and reminder emails.
# EMAIL_PROVIDER defaults to resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Replace these placeholders only when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-carepath-gmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=Carepath <your-carepath-gmail@gmail.com>
