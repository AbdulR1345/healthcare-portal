PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_portal
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
MEDICAL_UPLOADS_DIR=
# Development uses local private storage. Production requires a private S3 bucket
# with all public access blocked; use HTTPS for custom production endpoints.
MEDICAL_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=medical-documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production for verification, reset, and notification email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Healthcare Portal <noreply@healthcare.com>
