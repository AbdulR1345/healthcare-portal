{
  "name": "healthcare-portal-server",
  "version": "1.0.0",
  "description": "Healthcare Appointment & Patient Portal API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/db/migrate.js && node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node src/db/init.js",
    "db:migrate": "node src/db/migrate.js",
    "demo:seed": "node src/scripts/demoSeed.js",
    "admin:create": "node src/scripts/createAdmin.js",
    "user:delete": "node src/scripts/deleteUser.js",
    "test": "node test/run.js",
    "test:local": "node test/local.js",
    "test:watch": "node test/run.js --watch",
    "test:coverage": "node test/run.js --experimental-test-coverage",
    "test:ai": "python -m unittest discover -s ../ai-service -p 'test_*.py' -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "resend": "^6.32.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  }
}
